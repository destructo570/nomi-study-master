PORT=3001
WEB_ORIGIN=http://localhost:4004
DATABASE_URL=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
TRANSCRIPTAPI_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID= 
R2_BUCKET= 
R2_ACCESS_KEY_ID= 
R2_SECRET_ACCESS_KEY= 
R2_KEY_PREFIX=
R2_PUBLIC_BASE_URL=
REDIS_URL=

# Path to the venv Python that has PyMuPDF installed (defaults to "python3").
PDF_PARSER_PYTHON=

# RAG / embeddings
EMBED_MODEL=text-embedding-3-small
EMBED_WORKER_CONCURRENCY=1
ENABLE_EMBED_WORKER=true
RAG_TOP_K=8
ENABLE_FILE_WORKER=1
ENABLE_URL_INGEST_WORKER=1
FILE_WORKER_CONCURRENCY=1
URL_INGEST_CONCURRENCY=1
MAX_UPLOAD_BYTES=
RATE_LIMIT_DISABLED=false

# Discord webhooks for runtime logs (optional). When unset the logger is silent.
DISCORD_TRANSCRIPTION_WEBHOOK=
DISCORD_OPENAI_WEBHOOK=
DISCORD_GENERAL_WEBHOOK=

# Dodo Payments
# DODO_ENVIRONMENT: "test_mode" or "live_mode"
DODO_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_KEY=
# Product IDs from Dodo dashboard (one product per billing cadence)
DODO_PRODUCT_WEEKLY=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_YEARLY=

# PostHog (server-side). Re-uses the same project token as the web client so
# events from both surfaces land in one project. Host is the ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Podcast / Kokoro TTS — used by the "Podcast" tab. The TTS adapter posts to
# {OPENROUTER_BASE_URL}/audio/speech with model=KOKORO_MODEL_ID. If OpenRouter
# doesn't actually serve Kokoro, swap apps/backend/src/lib/tts/kokoro.ts to
# point at the right provider — no other code changes required.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KOKORO_MODEL_ID=
TRANSCRIBE_MODEL=
ENABLE_PODCAST_WORKER=1
PODCAST_WORKER_CONCURRENCY=1
PODCAST_TTS_CONCURRENCY=4

# Optional development-only chat context dumps. Never enable in production.
CHAT_DEBUG_DUMP=0
CHAT_SUMMARY_TOKEN_BUDGET=

# Optional content pipeline settings.
ENABLE_ARTICLE_CLEANUP=1
ARTICLE_CLEAN_MODEL=gpt-4o-mini
CONTENT_MODEL_ID=
